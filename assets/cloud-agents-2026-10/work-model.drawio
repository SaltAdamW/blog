<mxfile host="app.diagrams.net" type="device"><diagram id="work-model" name="一次任务的角色与反馈"><mxGraphModel page="1" pageWidth="1200" pageHeight="660"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="heading-0" value="一次任务的角色与反馈" vertex="1" parent="1" authority="analyst-teaching-layout" style="text;html=0;fontSize=24;fontFamily=Droid Sans Fallback;align=left;"><mxGeometry x="24" y="18" width="1152" height="30" as="geometry" /></mxCell><mxCell id="heading-1" value="分析用角色图：不是统一部署或所有厂商的保证" vertex="1" parent="1" authority="analyst-teaching-layout" style="text;html=0;fontSize=14;fontFamily=Droid Sans Fallback;align=left;"><mxGeometry x="24" y="50" width="1152" height="30" as="geometry" /></mxCell><mxCell id="ui" value="用户 / 界面&#10;提交目标、看结果" vertex="1" parent="1" authority="analyst-teaching-layout" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff;strokeColor=#94a3b8;fontSize=16;fontFamily=Droid Sans Fallback;"><mxGeometry x="30" y="280" width="180" height="100" as="geometry" /></mxCell><mxCell id="control" value="控制职责&#10;受理、环境选择、停止" vertex="1" parent="1" authority="analyst-teaching-layout" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=16;fontFamily=Droid Sans Fallback;"><mxGeometry x="260" y="280" width="210" height="100" as="geometry" /></mxCell><mxCell id="loop" value="Harness / Loop&#10;判断 → 行动 → 观察" vertex="1" parent="1" authority="analyst-teaching-layout" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=16;fontFamily=Droid Sans Fallback;"><mxGeometry x="535" y="280" width="230" height="100" as="geometry" /></mxCell><mxCell id="tool" value="Sandbox / 工具环境&#10;代码、文件、浏览器、进程" vertex="1" parent="1" authority="analyst-teaching-layout" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#059669;fontSize=16;fontFamily=Droid Sans Fallback;"><mxGeometry x="855" y="280" width="260" height="100" as="geometry" /></mxCell><mxCell id="model" value="模型服务&#10;产生下一步意图" vert