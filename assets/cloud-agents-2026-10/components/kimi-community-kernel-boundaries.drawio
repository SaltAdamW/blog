062" as="offset"/></mxGeometry></mxCell><mxCell id="node-0" value="未知：真实cloud控制服务 /&#xa;Agent Loop&#xa;环境供给、任务/用户、版本/TTL/&#xa;路由&#xa;不把客户端ToolService声明接成&#xa;本源码&#xa;[K16]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#8b9098;strokeWidth=1.733;dashed=1;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="outer" lane="control" laneAuthority="analyst-inference" authority="unknown" evidenceSource="K16"><mxGeometry x="745.333" y="295.334" width="336" height="190.666" as="geometry"/></mxCell><mxCell id="node-1" value="管理调用方角色&#xa;实际生产caller未取得&#xa;[K16]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#8b9098;strokeWidth=1.733;dashed=1;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="manage-client" lane="client" laneAuthority="analyst-inference" authority="unknown" evidenceSource="K16"><mxGeometry x="58.667" y="295.333" width="336" height="97.334" as="geometry"/></mxCell><mxCell id="node-2" value="kernel_server.py /&#xa;FastAPI管理API&#xa;8路径；无HTTP execute&#xa;handler仅查询lifespan对象B&#xa;[K16 / ART-KIMI-KERNEL-COMMUN&#xa;ITY]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="api" lane="control" laneAuthority="analyst-inference" authority="artifact" evidenceSource="K16 / ART-KIMI-KERNEL-COMMUNITY"><mxGeometry x="745.333" y="548.667" width="336" height="166.666" as="geometry"/></mxCell><mxCell id="node-3" value="模块构造位置A&#xa;kernel=JupyterKernel()&#xa;两次本机样本均另有非API&#xa;kernel；生产未知&#xa;[K16 / ART-KIMI-KERNEL-COMMUN&#xa;ITY]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fil