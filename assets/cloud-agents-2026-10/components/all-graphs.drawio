;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="watcher" lane="control" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="793.333" y="1083.947" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-5" value="每node Edge&#xa;最终capacity admission可拒绝&#xa;storage/network/runtime/TTL/sn&#xa;apshot&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="edge" lane="execution" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="1532" y="324" width="336" height="144" as="geometry"/></mxCell><mxCell id="node-6" value="Container：Docker&#xa;位于QEMU/libvirt VM内&#xa;其VM kernel/租户基数未披露&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="container" lane="tools" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="2974.667" y="324" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-7" value="MicroVM：Firecracker&#xa;独立guest kernel&#xa;不默认兼容virtio-fs&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="microvm" lane="tools" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="2974.667" y="506.667" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-8" value="Full VM：QEMU等&#xa;GUI/Android/GPU-PV&#xa;不与container混同&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="fullvm" lane="tools" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="2974.667" y="689.333" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-9" value="FnCall预建CPU/GPU容器池&#xa;位于QEMU VM/独立执行路径&#xa;best-effort cleanup，非全清理&#xa;保证&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="fncall" lane="tools" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="2974.667" y="871.947" width="336" height="144" as="geometry"/></mxCell><mxCell id="node-10" value="Sandbox内Aether proxy&#xa;edge用UDS或vsock连接&#xa;按terminal-session管理Chronus&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="aether" lane="tools" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="2974.667" y="1078.613" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-11" value="Sandbox内多个Chronus&#xa;exec/file/HTTP/streaming I/O&#xa;terminal结束终止对应进程树&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fill