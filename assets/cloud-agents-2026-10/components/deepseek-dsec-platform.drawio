xy&#xa;创建+exec+streaming全经入口&#xa;无per-sandbox状态，ID编码edge&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="api" lane="control" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="793.333" y="569.333" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-3" value="Placement engine&#xa;健康/能力过滤＋power-of-k&#xa;本实例in-flight overlay/无dura&#xa;ble执行态&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="placement" lane="control" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="793.333" y="814.613" width="336" height="144" as="geometry"/></mxCell><mxCell id="node-4" value="Watcher定期probe健康/负载&#xa;可从edge重建fleet视图&#xa;不等于rollout状态重建&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="watcher" lane="control" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="793.333" y="1083.947" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-5" value="每node Edge&#xa;最终capacity admission可拒绝&#xa;storage/network/runtime/TTL/sn&#xa;apshot&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;