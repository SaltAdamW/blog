<mxfile host="app.diagrams.net" type="device"><diagram id="work-model-mobile" name="一次任务的角色与反馈"><mxGraphModel page="1" pageWidth="420" pageHeight="1120"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="heading-0" value="一次任务的角色与反馈" vertex="1" parent="1" authority="analyst-teaching-layout" style="text;html=0;fontSize=24;fontFamily=Droid Sans Fallback;align=left;"><mxGeometry x="24" y="18" width="372" height="30" as="geometry" /></mxCell><mxCell id="heading-1" value="分析用角色图：不是统一部署或所有厂商的保证" vertex="1" parent="1" authority="analyst-teaching-layout" style="text;html=0;fontSize=14;fontFamily=Droid Sans Fallback;align=left;"><mxGeometry x="24" y="50" width="372" height="30" as="geometry" /></mxCell><mxCell id="ui" value="用户 / 界面&#10;提交目标、看结果" vertex="1" parent="1" authority="analyst-teaching-layout" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff;strokeColor=#94a3b8;fontSize=16;fontFamily=Droid Sans Fallback;"><mxGeometry x="30" y="100" width="360" height="85" as="geometry" /></mxCell><mxCell id="control" value="控制职责&#10;受理、选择环境、停止" vertex="1" parent="1" authority="analyst-teaching-layout" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=16;fontFamily=Droid Sans Fallback;"><mxGeometry x="30" y="235" width="360" height="85" as="geometry" /></mxCell><mxCell id="loop" value="Harness / Loop&#10;判断 → 行动 → 观察" vertex="1" parent="1" authority="analyst-teaching-layout" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=16;fontFamily=Droid Sans Fallback;"><mxGeometry x="30" y="370" width="360" height="100" as="geometry" /></mxCell><mxCell id="model" value="模型服务&#10;下一步意图" vertex="1" parent="1" authority="analyst-teaching-layout" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff;strokeColor=#94a3b8;fontSize=16;fontFamily=Droid Sans Fallback;"><mxGeometry x="30" y="520" width="165" height="95" as="geometry" /></mxCell><mxCell id="tool" value="Sandbox&#10;实际操作" vertex="1" parent="1" aut