;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="callback-error" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-KIMI-STREAM"><mxGeometry x="322.667" y="1173.333" width="336" height="144" as="geometry"/></mxCell><mxCell id="node-7" value="未知：ToolService/环境调用&#xa;后台主/子Agent与工具是否停&#xa;精确事件游标/磁盘恢复保证" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#8b9098;strokeWidth=1.733;dashed=1;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="unknown" lane="execution" laneAuthority="analyst-inference" authority="unknown" evidenceSource=""><mxGeometry x="1726.667" y="324.666" width="336" height="97.334" as="geometry"/></mxCell><mxCell id="node-8" value="Swarm stopAllAgents&#xa;stopAgents(chatId)后listAgents&#xa; refresh&#xa;throwing fixture非原query默认&#xa;[ART-KIMI-ARTIFACT-CONTROL /&#xa;ART-KIMI-QUERY-BOUNDARY]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="swarm-stop" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-KIMI-ARTIFACT-CONTROL / ART-KIMI-QUERY-BOUNDARY"><mxGeometry x="322.667" y="1380.667" width="336" height="166.666" as="geometry"/></mxCell><mxCell id="node-9" value="按agentId读消息&#xa;最多20页/pageSize100&#xa;普通generating可订阅流&#xa;share路径仅列表（静态）&#xa;[ART-KIMI-ARTIFACT-CONTROL /&#xa;REA-KIMI-ARTIFACT-REPLAY]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPa