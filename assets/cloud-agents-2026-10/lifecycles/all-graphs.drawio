RT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="receive" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-QW-TRANSPORT"><mxGeometry x="381.333" y="776" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-4" value="HTTP /ws/pull + token&#xa;task全部／device只最新&#xa;simple initCatchup不广播&#xa;[ART-QW-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="pull" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-QW-TRANSPORT"><mxGeometry x="381.333" y="1021.333" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-5" value="pull先写本地ackSeq再parse&#xa;非法JSON样本seq15/无广播&#xa;非持久ACK证明&#xa;[ART-QW-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="seq" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-QW-TRANSPORT"><mxGeometry x="381.333" y="1266.667" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-6" value="原静态RmbService/alias接线&#xa;loopback页端channel/port为合成&#xa;原12009→通知query&#xa;[ART-QW-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="dispatch" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-QW-TRANSPORT"><mxGeometry x="381.333" y="1512" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-7" value="taskId→queryTaskDetail&#xa;原HTTP POST / AGENT_API&#xa;响应sessionId／项目归属&#xa;[ART-QW-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="task" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-QW-TRANSPORT"><mxGeometry x="381.333" y="1757.333" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-8" value="原task realtimeTaskVersions筛&#xa;选&#xa;fixture query响应normal_comple&#xa;te&#xa;ACK不等待query完成&#xa;[ART-QW-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="view" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-QW-TRANSPORT"><mxGeometry x="381.333" y="2002.001" width="336" height="166.666" as="geometry"/></mxCell><mxCell id="node-9" value="disconnectPort移除当前端口&#xa;不直接close socket&#xa;浏览器生命周期未验&#xa;[ART-QW-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="detach" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-QW-TRANSPORT"><mxGeometry x="381.333" y="2232" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-10" value="未知：权威状态/工具终态&#