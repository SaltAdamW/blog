NG"><mxGeometry x="3030.667" y="800.053" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-13" value="open / activate，静态&#xa;persistSession:true先local&#xa;transcript&#xa;未取得才host Store /&#xa;无副本可新建&#xa;[ART-CBC-SERVING]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="open" lane="execution" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-CBC-SERVING"><mxGeometry x="1533.333" y="1182.054" width="336" height="166.666" as="geometry"/></mxCell><mxCell id="node-14" value="未知：真实FIFO / B是否被取消&#xa;外部资源全部退出 / durable&#xa;checkpoint&#xa;宿主重启与业务效果恢复&#xa;[ART-CBC-SERVING]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#8b9098;strokeWidth=1.733;dashed=1;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="unknown" lane="external" laneAuthority="analyst-inference" authority="unknown" evidenceSource="ART-CBC-SERVING"><mxGeometry x="3764" y="324.053" width="336" height="144" as="geometry"/></mxCell><mxCell id="lane-label-client-0" value="客户端" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Droid Sans Fallback;fontSize=16;fontColor=#56616c;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="45.333" y="211.52" width="53.333" height="21.6" as="geometry"/></mxCell><mxCell id="lane-label-control-0" value="控制与资源管理" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Droid Sans Fallback;fontSize=16;fontColor=#56616c;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="781.333" y="211.52" width="117.333" height="21.6" as="geometry"/></mxCell><mxCell id="lane-label-exe