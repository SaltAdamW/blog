=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="pause" lane="control" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="601.333" y="324" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-3" value="container：docker pause&#xa;冻结tree，启用swap/reclaim&#xa;不是CRIU/销毁容器&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="container" lane="tools" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="2078.667" y="324" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-4" value="保留execution state&#xa;内存换出/回收，writes local&#xa;不证节点损失耐久&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="memory" lane="state" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="2780" y="324" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-5" value="microVM：保存memory/execution&#xa;snapshot，终止Firecracker&#xa;释放运行内存&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="vm" lane="tools" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="2078.667" y="506.667" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-6" value="microVM memory snapshot&#xa;与pack_diff disk环境快照不同&#xa;数据位置/原子提交细节未知&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="snapshot" lane="state" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="2780" y="506.667" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-7" value="后续Sandbox操作请求&#xa;透明resume后执行&#xa;正常trainer也可重连rollout&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="request" lane="client" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="58.667" y="324" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-8" value="container MADV_WILLNEED&#xa;异步prefetch＋docker unpause&#xa;同一容器execution state&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="container-resume" lane="tools" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="2078.667" y="689.333" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-9" value="新Firecracker process&#xa;restore snapshot继续guest&#xa;不承诺跨node故障恢复&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="vm-resume" lane="tools" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="2078.667" y="872" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-10" value="rollout继续，GPU job重连&#xa;不需要早期command-log重建&#xa;不证明外部效果exactly-once&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="continue" lane="execution" laneAuthority="analyst-inference" authority="official" evidenceSource="DS07"><mxGeometry x="1420" y="506.667" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-11" value="未知：worker/node崩溃&#xa;恢复状态权威/跨机器迁移&#xa;远端副作用去重&#xa;[DS07]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#8b9098;strokeWidth=1.733;dashed=1;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="fault" lane="execution" laneAuthority="analyst-inference" authority="unknown" evidenceSource="DS07"><mxGeometry x="1420" y="689.333" width="336" height="120" as="geometry"/></mxCell><mxCell id="lane-label-client-0" value="客户端" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Droid Sans Fallback;fontSize=16;fontColor=#56616c;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="45.333" y="211.467" width="53.333" height="21.6" as="geometry"/></mxCell><mxCell id="lane-label-control-0" value="控制与资源管理" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Droid Sans Fallback;fontSize=16;fontColor=#56616c;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="588" y="211.467" width="117.333" height="21.6" as="geometry"/></mxCell><mxCell id="lane-label-execution-0" value="执行与编排" style="text;html=0;strokeColor=none;f