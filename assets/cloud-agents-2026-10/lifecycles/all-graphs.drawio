ght="97.334" as="geometry"/></mxCell><mxCell id="node-2" value="应用阶梯重试connect()&#xa;前7次1秒，之后2秒等；最多300秒&#xa;间隔&#xa;[ART-MANUS-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="retry" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-MANUS-TRANSPORT"><mxGeometry x="378.667" y="729.333" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-3" value="connect后清重试定时器&#xa;连接计数&gt;1触发重新加入&#xa;[ART-MANUS-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="connected" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-MANUS-TRANSPORT"><mxGeometry x="378.667" y="973.999" width="336" height="97.334" as="geometry"/></mxCell><mxCell id="node-4" value="有currentSession才join_session&#xa;/version2&#xa;lastMessageId游标；只emit不等j&#xa;oin ACK&#xa;[ART-MANUS-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="join" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-MANUS-TRANSPORT"><mxGeometry x="378.667" y="1196" width="336" height="144" as="geometry"/></mxCell><mxCell id="node-5" value="eventsNotifyEventsAfter&#xa;eventId游标 / 批次事件&#xa;[ART-MANUS-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;