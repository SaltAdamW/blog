ate" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-DSH-RUNTIME"><mxGeometry x="948" y="506.667" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-3" value="flush成功才构造model stream&#xa;下游adapter为合成generator&#xa;没有真实模型请求&#xa;[REA-DSH-RUNTIME-REPLAY]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#f1eef5;strokeColor=#80708f;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="dispatch" lane="external" laneAuthority="analyst-inference" authority="rea" evidenceSource="REA-DSH-RUNTIME-REPLAY"><mxGeometry x="1690.667" y="324" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-4" value="顶层agent工具listener&#xa;先flush再检查AbortSignal&#xa;nested/agentless此listener&#xa;bypass&#xa;[ART-DSH-RUNTIME]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="tool" lane="execution" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-DSH-RUNTIME"><mxGeometry x="58.667" y="506.667" width="336" height="144" as="geometry"/></mxCell><mxCell id="node-5" value="flush期间abort&#xa;返回aborted-before-dispatch&#xa;未执行下游next&#xa;[REA-DSH-RUNTIME-REPLAY]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#f1eef5;strokeColor=#80708f;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="abort" lane="execution" laneAuthority="analyst-inference" authority="rea" evidenceSource="REA-DSH-RUNTIME-REPLAY"><mxGeometry x="58.667" y="713.333" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-6" value="原append真实write完成后&#xa;首次sync wrapper主动th