ete不证明持久化成功&#xa;[ART-CODEX-SOURCE]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="shutdown" lane="execution" laneAuthority="analyst-inference" authority="official" evidenceSource="ART-CODEX-SOURCE"><mxGeometry x="1329.333" y="714.64" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-7" value="Local同步terminate /&#xa;ExecServer&#xa;远端terminate可best-effort/awa&#xa;it请求&#xa;[ART-CODEX-SOURCE]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eaf6f5;strokeColor=#27858c;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="backends" lane="tools" laneAuthority="analyst-inference" authority="official" evidenceSource="ART-CODEX-SOURCE"><mxGeometry x="2065.333" y="546.64" width="336" height="144" as="geometry"/></mxCell><mxCell id="node-8" value="未知：后台实际终止/daemon存活&#xa;云取消请求/部署映射/外部副作用&#xa;线程关闭不是环境销毁证明" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#8b9098;strokeWidth=1.733;dashed=1;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="unknown" lane="control" laneAuthority="analyst-inference" authority="unknown" evidenceSource=""><mxGeometry x="601.333" y="324.639" width="336" height="97.334" as="geometry"/></mxCell><mxCell id="node-9" value="原PTY terminate / signal_exit&#xa;/ exit_code&#xa;定向REA：本地状态与I/O清理&#xa;Rust ABI / 完整CFG /&#xa;强杀目标未知&#xa;[REA-CODEX-SCOPED-NATIVE]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#f1eef5;strokeColor=#80708f;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize