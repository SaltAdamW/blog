trokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="producer" lane="execution" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-AR-EXECUTION"><mxGeometry x="1522.667" y="640.667" width="336" height="166.666" as="geometry"/></mxCell><mxCell id="node-2" value="原HTTP loopback socket已close&#xa;解除合成gate后callback仍完成&#xa;并非cloud cancel API观察&#xa;[REA-AR-EXECUTION-REPLAY]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#f1eef5;strokeColor=#80708f;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="disconnect" lane="client" laneAuthority="analyst-inference" authority="rea" evidenceSource="REA-AR-EXECUTION-REPLAY"><mxGeometry x="58.667" y="324" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-3" value="formatter终局&#xa;nonstream ERROR可投影HTTP200/s&#xa;top&#xa;AG-UI自动tool-end/run-finished&#xa;非全停&#xa;[ART-AR-EXECUTION]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="finish" lane="state" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-AR-EXECUTION"><mxGeometry x="2787.998" y="324.667" width="340.003" height="166.666" as="geometry"/></mxCell><mxCell id="node-4" value="ensure无缓存await&#xa;create→缓存→ready&#xa;并发双create/交错ready返回共享&#xa;实例&#xa;可拿到另一尚未ready对象，仅模&#xa;拟&#xa;[ART-AR-EXECUTION]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="ensure" lane="execution" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-AR-EXECUTION"><mxGeometry x="1522.667" y="870.001" width="336" height="190.666" as="geometry"/></mxCell><mxCell id="node-5" value="runInSandbox callback(sb)&#xa;首次ensure在try外&#xa;只有callback throw进入重建分支&#xa;[ART-AR-EXECUTION]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="operate" lane="execution" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-AR-EXECUTION"><mxGeometry x="1522.667" y="1185.373" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-6" value="清当前缓存再新create/ready&#xa;同callback再执行一次&#xa;不先stop旧实例/核对外部效果&#xa;[ART-AR-EXECUTION]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="recreate" lane="execution" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-AR-EXECUTION"><mxGeometry x="1522.667" y="1430.707" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-7" value="独立toolset.close&#xa;调用stop Promise不await&#xa;缓存不清，返回非资源全停收据&#xa;[ART-AR-EXECUTION]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="close" lane="execution" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-AR-EXECUTION"><mxGeometry x="1522.667" y="1613.373" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-8" value="runCode context路径&#xa;无ID临时context/execute/finall&#xa;y delete&#xa;显式ID不删除；缺exitCode缺省0&#xa;[ART-AR-EXECUTION]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="context" lane="tools" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-AR-EXECUTION"><mxGeometry x="2245.333" y="324" width="336" height="144" as="geometry"/></mxCell><mxCell id="node-9" value="未知：业务效果/上下文一致性&#xa;真实旧环境清理/tool-tree终态&#xa;Session/Task/Attempt归属与恢复&#xa;[ART-AR-EXECUTION]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#8b9098;strokeWidth=1.733;dashed=1;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="unknown" lane="control" laneAuthority="analyst-inference" authority="unknown" evidenceSource="ART-AR-EXECUTION"><mxGeometry x="601.333" y="324" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-10" value="默认HTTP/协议调用invoke(reques&#xa;t)&#xa;未传options.signal，无disconne&#xa;ct转交&#xa;与直接Invoker signal试验分开&#xa;[ART-AR-EXECUTION]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="http-call" lane="execution" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-AR-EXECUTION"><mxGeometry x="1522.667" y="1796.707" width="336" height="166.666" as="geometry"/></mxCell><mxCell id="node-11" value="默认HTTP调用结果为AsyncIterabl&#xa;e&#xa;Invoker逐item归一化供formatter&#xa;该路径没有options.signal检查来&#xa;源&#xa;[ART-AR-EXECUTION]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666