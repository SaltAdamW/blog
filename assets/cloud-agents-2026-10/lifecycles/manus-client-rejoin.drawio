ect / offline&#xa;清连接ready / 开启重试定时器&#xa;[ART-MANUS-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="disconnect" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-MANUS-TRANSPORT"><mxGeometry x="378.667" y="507.333" width="336" height="97.334" as="geometry"/></mxCell><mxCell id="node-2" value="应用阶梯重试connect()&#xa;前7次1秒，之后2秒等；最多300秒&#xa;间隔&#xa;[ART-MANUS-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="retry" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-MANUS-TRANSPORT"><mxGeometry x="378.667" y="729.333" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-3" value="connect后清重试定时器&#xa;连接计数&gt;1触发重新加入&#xa;[ART-MANUS-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="connected" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-MANUS-TRANSPORT"><mxGeometry x="378.667" y="973.999" width="336" height="97.334" as="geometry"/></mxCell><mxCell id="node-4" value="有currentSession才join_session&#xa;/version2&#xa;lastMessageId游标；只emit不等j&#xa;oin ACK&#xa;[ART-MANUS-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="join" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-MANUS-TRANSPORT"><mxGeometry x="378.667" y="1196" width="336" height="144" as="geometry"/></mxCell><mxCell id="node-5" value="eventsNotifyEventsAfter&#xa;eventId游标 / 批次事件&#xa;[ART-MANUS-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="events" lane="state" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-MANUS-TRANSPORT"><mxGeometry x="1822.667" y="324.666" width="336" height="97.334" as="geometry"/></mxCell><mxCell id="node-6" value="启动hydrate Cascade Jobs&#xa;rejoin不await；完成/内容仍未验&#xa;独立job/group停止请求与终态匹&#xa;配&#xa;[ART-MANUS-TRANSPORT]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="jobs" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-MANUS-TRANSPORT"><mxGeometry x="378.667" y="1465.333" width="336" height="144" as="geometry"/></mxCell><mxCell id="node-7" value="未知：执行Loop/VM恢复&#xa;事件保留/缺口/幂等副作用&#xa;全局续期/退出与runtime部署" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#8b9098;strokeWidth=1.733;dashed=1;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="unknown" lane="execution" laneAuthority="analyst-inference" authority="unknown" evidenceSource=""><mxGeometry x="1116" y="324.666" width="336" height="97.334" as="geometry"/></mxCell><mxCell id="node-8" value="原message handler: Invalid&#xa;Token&#xa;closure重复guard；destroy /&#xa;set socket=null&#xa;不直接refresh或重新join&#xa;[ART-MANUS-AUTH]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="invalid" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-MANUS-AUTH"><mxGeometry x="378.667" y="1672.667" width="336" height="166.666" as="geometry"/></mxCell><mxCell id="node-9" value="UserService.userInfo请求&#xa;成功replace app root&#xa;失败toast + login redirect&#xa;[ART-MANUS-AUTH]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#666e7b;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="userinfo" lane="client" laneAuthority="analyst-inference" authority="artifact" evidenceSource="ART-MANUS-AUTH"><mxGeometry x="378.667" y="1964" width="336" height="120" as="geometry"/></mxCell><mxCell id="node-10" value="有限原helper回放&#xa;七组/六选段，合成token/RPC/nav&#xa;igation&#xa;未运行connectChat或真实Cookie&#xa;[REA-MANUS-AUTH-REPLAY]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#f1eef5;strokeColor=#80708f;strokeWidth=1.733;dashed=0;dashPattern=6 4;fontColor=#253138;fontFamily=Droid Sans Fallback;fontSize=17.333;spacing=8;" vertex="1" parent="1" graphNodeId="auth-fixture" lane="client" laneAuthority="analyst-inference" authority="rea" evidenceSource="REA-MANUS-AUTH-REPLAY"><mxGeometry x="378.667" y="2146.667" width="336" height="144" as="geometry"/></mxCell><mxCell id="lane-label-client-0" value="客户端" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Droid Sans Fallback;fontSize=16;fontColor=#56616c;fontStyle=0